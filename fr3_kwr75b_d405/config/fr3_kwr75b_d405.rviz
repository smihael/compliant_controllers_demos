Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Value: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: fr3_link0
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/RobotModel
    Name: FR3, KWR75B and Hand
    Enabled: true
    Alpha: 1
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /fr3/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: false
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.1
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/Axes
    Name: Native force axes
    Enabled: true
    Reference Frame: ft_sensor
    Length: 0.06
    Radius: 0.002
  - Class: rviz_default_plugins/Wrench
    Name: Force and torque
    Value: true
    Alpha: 1
    Arrow Width: 0.01
    Force Color: 255; 180; 40
    Torque Color: 60; 210; 255
    Enabled: true
    History Length: 1
    Force Arrow Scale: 0.01
    Torque Arrow Scale: 0.2
    Topic:
      Value: /ft_sensor/wrench_visualization
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Camera color
    Enabled: true
    Transport Hint: raw
    Normalize Range: true
    Topic:
      Value: /d405/color/image_raw
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Hand and camera holder
      Target Frame: fr3_link8
      Distance: 0.65
      Pitch: 0.55
      Yaw: 0.65
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
Window Geometry:
  Width: 1450
  Height: 950

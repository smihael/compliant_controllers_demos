# Copy to .env and fill in locally. Never commit the real robot address.
ROBOT_IP=
USER_UID=1000
USER_GID=1000
ROS_DOMAIN_ID=11
FRANKA_CPUSET=20-27
FRANKA_MEMLOCK=8428281856
CONTROLLER_NAME=cartesian_impedance_controller
FRANKA_BASE_IMAGE=compliant-controllers:franka-real
EE_FRAME=fr3_link8
ONROBOT_IP=
ONROBOT_PORT=49152
ONROBOT_SPEED=10
ONROBOT_FILTER=4
ONROBOT_SAMPLES_PER_REQUEST=10
ONROBOT_BIAS_ON_START=false
ROBOTIQ_COM_PORT=/dev/ttyUSB0
# Set to the host serial device group: stat -c %g /dev/ttyUSB0
ROBOTIQ_DEVICE_GID=20

# Disable serial drivers when the mounted gripper is connected elsewhere.
START_ROBOTIQ=true

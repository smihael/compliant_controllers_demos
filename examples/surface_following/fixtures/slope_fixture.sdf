<?xml version="1.0"?>
<sdf version="1.9">
  <model name="slope_fixture">
    <!-- The real fixture is clamped. Static is its simulation equivalent. -->
    <static>true</static>
    <link name="fixture">
      <collision name="slope_collision">
        <geometry>
          <mesh>
            <uri>file:///opt/demo/fixtures/slope.STL</uri>
            <!-- The source STL is in millimetres. -->
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.35</mu>
              <mu2>0.35</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>500000</kp>
              <kd>100</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.0002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="slope_visual">
        <geometry>
          <mesh>
            <uri>file:///opt/demo/fixtures/slope.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.65 0.67 0.70 1</ambient>
          <diffuse>0.80 0.82 0.85 1</diffuse>
          <specular>0.45 0.45 0.45 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>

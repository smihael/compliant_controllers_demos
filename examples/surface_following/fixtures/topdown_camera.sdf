<?xml version="1.0"?>
<sdf version="1.9">
  <model name="topdown_camera">
    <!-- Non-static so Gazebo's /set_pose transport topic can retune it. -->
    <static>false</static>
    <!-- Stable Gazebo GUI pose: broad view of the robot and fixture. -->
    <pose>0.20 -1.00 1.00 0 0 1.00</pose>
    <link name="camera_link">
      <sensor name="topdown" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/surface_camera/image</topic>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>800</width>
            <height>600</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
